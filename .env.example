# Copy to .env.local (Next) and .env (scripts) and fill in. Validated at boot by src/env.ts.

# --- App -------------------------------------------------------------------
# Public base URL, used in tracking links and auth callbacks.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shop WhatsApp in international form without "+" (B1: 01116891025).
NEXT_PUBLIC_WHATSAPP_NUMBER=201116891025

# --- Database --------------------------------------------------------------
# Runtime (pooled) connection. On Vercel + Neon this is set by the integration.
DATABASE_URL=postgres://youzersef:youzersef@localhost:5432/youzersef
# Direct connection for migrations. Optional locally (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=

# --- Secrets (generate each with: openssl rand -base64 32) -------------------
# Better Auth session signing/encryption.
BETTER_AUTH_SECRET=
# HMAC key for hashing tracking-link tokens, OTPs and invitation tokens.
TOKEN_HASH_SECRET=
# Signs the per-order customer tracking cookie.
TRACKING_COOKIE_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/*.
CRON_SECRET=

# --- File storage (Vercel Blob) -------------------------------------------------
# Set by the Vercel Blob integration. Uploads are disabled without it.
BLOB_READ_WRITE_TOKEN=
# Newer stores set these instead (OIDC auth; the client then uses uploadPresigned).
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# --- Rate limiting (Upstash Redis) --------------------------------------------
# Both URL and TOKEN are required in Vercel production. Without them, development
# uses an in-memory limiter per instance (not safe across serverless replicas).
# The Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to true only for local e2e runs. Forbidden when VERCEL_ENV=production.
RATE_LIMIT_DISABLED=false

# --- Messaging -------------------------------------------------------------
# manual = prepare a wa.me link for staff to tap (MVP). whatsapp_cloud = WhatsApp Business API.
MESSAGING_PROVIDER=manual
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# --- Analytics [pending B13 #7] ----------------------------------------------
# none · plausible · ga4
ANALYTICS_PROVIDER=none

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# debug · info · warn · error
LOG_LEVEL=

# --- Seed (pnpm db:seed) -----------------------------------------------------
SEED_ADMIN_NAME=المدير
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
# At least 12 characters. Change it after first login.
SEED_ADMIN_PASSWORD=
# true adds clearly marked demo orders/customers. Never in production.
SEED_DEMO=false

# --- Playwright e2e (optional local; set in CI) --------------------------------
# Desk smoke user (scripts/seed-e2e.ts). Leave blank locally to skip staff login specs.
E2E_DESK_PHONE=01000000010
E2E_DESK_PASSWORD=
# Tracking fixtures (same script). Omit E2E_TRACKING_REF locally to skip DB-backed
# tracking specs without connecting to a database.
E2E_TRACKING_REF=
E2E_TRACKING_PHONE=01000000020
E2E_TRACKING_OTHER_REF=YZ-E2ETRB
E2E_TRACKING_OTHER_PHONE=01000000021
E2E_TRACKING_VISIBLE_EVENT=تم إرسال الطلب
E2E_TRACKING_HIDDEN_NOTE=E2E_STAFF_ONLY_NOTE
E2E_TRACKING_INTERNAL_NOTE=E2E_INTERNAL_ORDER_NOTE
